# Supabase Client Configuration (Public / Publishable)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Server-Only Privileged Key (NEVER prefix with NEXT_PUBLIC_, NEVER commit real key)
# Required only for privileged server endpoints (auth user deletion & server-side username login lookup)
SUPABASE_SERVICE_ROLE_KEY=

# Application URL (used for auth verification & invite links)
NEXT_PUBLIC_SITE_URL=https://bizimfilm.vercel.app
